{% extends "basefront.html.twig" %}

{% block body %}
    <div class="row mt-3">
        <div class="co1">
            <h5>{{ visite.datecreationstring }}</h5>
            <h1 class="text-primary mt-5">{{ visite.ville }}</h1>
            <h3>{{ visite.pays }}</h3>
            {% if visite.note>=10 %}
                <h2 class="text-success mt-5">{{ visite.note }}</h2>
            {% else %}
                <h2 class="text-danger mt-5">{{ visite.note }}</h2>
            {% endif %}
        </div>
        <div class="co1">
            <!-- emplacement photo -->
        </div>
    </div>
    <div class="row mt-5">
        <div class="co1 md-12">
            <p><strong>Mon avis :</strong></p>
            <p>
                {{ visite.avis }}
            </p>
        </div>
    </div>
{% endblock %}